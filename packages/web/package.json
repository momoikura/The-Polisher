{
  "name": "@thepolisher/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sim": "vite --mode sim",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "build:server": "pnpm --filter @thepolisher/core --filter @thepolisher/agents build && node scripts/build-server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1158.0",
    "@aws-sdk/lib-dynamodb": "^3.1158.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@thepolisher/agents": "workspace:*",
    "@thepolisher/core": "workspace:*",
    "line-awesome": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}

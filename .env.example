# ThePolisher configuration. Copy to .env (repo root) and restart the dev server.
# Placeholders only: never commit real keys.

# === Which model the agents use ===
# meta = Meta Model API, Muse Spark (default; what the hackathon build runs on).
# anthropic = Claude, only for local comparison runs.
MODEL_PROVIDER=meta

# === Meta Model API (Muse Spark) ===
# Take the base URL and key from dev.meta.ai (Meta Model API docs). The endpoint
# must be OpenAI-compatible (POST {MODEL_BASE_URL}/chat/completions).
MODEL_BASE_URL=
MODEL_API_KEY=
# Leave blank for the default, muse-spark-1.3.
MODEL_ID=

# Request timeout in milliseconds (repairs ask for whole files in one reply).
MODEL_TIMEOUT_MS=300000

# === Claude (optional) ===
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, strongest), claude-sonnet-5-5 (~half the price), claude-haiku-5-5 (cheapest).
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high (default) | xhigh | max. Higher = more thorough and more tokens.
CLAUDE_EFFORT=high

# === Test sandbox (Modal) ===
# Deploy sandbox-service/modal_app.py (setup steps are in its header), then paste
# the URL + "/validate" and the same token you stored in the Modal secret.
# Without it, tests can't run and no PR can be fully signed off.
SANDBOX_URL=
SANDBOX_TOKEN=

# === GitHub ===
# Optional for reading public issues (raises rate limits). Required for "Open PR",
# with write access to the target repo (fine-grained token: Contents + Pull requests: read/write).
GITHUB_TOKEN=

# === Demo ===
# 1 = scripted replies, no API calls (same as `pnpm --filter @thepolisher/web dev:sim`).
THEPOLISHER_SIMULATE=

# === Storage ===
DATABASE_PATH=./data/thepolisher.db

# === Run history + shared memory (AWS DynamoDB, optional) ===
# Leave THEPOLISHER_TABLE blank to keep history and memory in local files under ./data.
# To share them through DynamoDB: create an IAM user with only the DynamoDB permissions
# in the README, put its key here, then run: node packages/web/scripts/create-table.mjs
THEPOLISHER_TABLE=
AWS_REGION=ap-southeast-2
# Locally, sign in with `aws login --profile <name>` and set AWS_PROFILE instead of keys.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

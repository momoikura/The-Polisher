# PolishLoop configuration. Copy to .env (repo root) and restart the dev server.
# Placeholders only: never commit real keys.

# === Which model the agents use ===
# anthropic = Claude (recommended while tuning), meta = Meta Model API (default).
MODEL_PROVIDER=anthropic

# === Claude ===
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, strongest), claude-sonnet-5-5 (~half the price), claude-haiku-5-5 (cheapest).
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high (default) | xhigh | max. Higher = more thorough and more tokens.
CLAUDE_EFFORT=high

# === Meta Model API ===
# Take all three values from your hackathon / Meta developer docs. The endpoint
# must be OpenAI-compatible (POST {MODEL_BASE_URL}/chat/completions).
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# Request timeout in milliseconds (repairs ask for whole files in one reply).
MODEL_TIMEOUT_MS=300000

# === Test sandbox (Modal) ===
# Deploy sandbox-service/modal_app.py (setup steps are in its header), then paste
# the URL + "/validate" and the same token you stored in the Modal secret.
# Without it, tests can't run and no PR can be fully signed off.
SANDBOX_URL=
SANDBOX_TOKEN=

# === GitHub ===
# Optional for reading public issues (raises rate limits). Required for "Open PR",
# with write access to the target repo (fine-grained token: Contents + Pull requests: read/write).
GITHUB_TOKEN=

# === Demo ===
# 1 = scripted replies, no API calls (same as `pnpm --filter @polishloop/web dev:sim`).
POLISHLOOP_SIMULATE=

# === Storage ===
DATABASE_PATH=./data/polishloop.db
